# Copia este archivo como .env y pon tus valores. El .env real nunca se sube a GitHub.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=codemaster
# true si la base de datos exige conexión cifrada (Aiven, TiDB, Azure...)
DB_SSL=false

# Puerto de la app (en la nube no se pone: lo asigna el servicio)
PORT=3000

# Clave para firmar los tokens. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esta_clave

# Opcional: otra instancia de Wandbox
# WANDBOX_URL=https://wandbox.org
